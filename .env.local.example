# --- Google Drive (OAuth - reused from your other project, only change the folder ID) ---
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
DRIVE_REFRESH_TOKEN=
GDRIVE_ROOT_FOLDER_ID=

# --- Google Sheets, via Apps Script Web App (same pattern as EM Viable) ---
# Deploy Code.gs on the spreadsheet as a Web App, paste its /exec URL here.
# APPS_SCRIPT_SECRET must match the WEBAPP_SECRET constant set inside Code.gs.
APPS_SCRIPT_WEB_APP_URL=
APPS_SCRIPT_SECRET=

# --- Upstash Redis (sessions + short-lived view tokens) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- App ---
SESSION_TTL_SECONDS=28800
VIEW_TOKEN_TTL_SECONDS=600
MAX_UPLOAD_SIZE_BYTES=20971520
